# Modèle de configuration. Copiez ce fichier en « .env » et remplissez les valeurs.
# Le fichier .env contient des secrets : il ne doit jamais être publié sur GitHub.

# Chaîne de connexion MongoDB (en local ou MongoDB Atlas)
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.exemple.mongodb.net/bdpm

# Port du serveur web
PORT=3000

# Optionnel : planning du scheduler (syntaxe cron). Défaut : tous les lundis à 3 h.
# CRON_SCHEDULE=0 3 * * 1
